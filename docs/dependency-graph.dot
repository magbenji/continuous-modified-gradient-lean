    "Example21.stable" [label=<<FONT FACE="Courier">Example21.stable</FONT><BR/><FONT POINT-SIZE="9">Ex 2.1</FONT>>, color="#8a5a12", fillcolor="#f6ead2", penwidth=1.6];
