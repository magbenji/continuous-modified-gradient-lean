    "first_exit" [label=<<FONT FACE="Courier">first_exit</FONT>>];
  }
  "basin_invariant" -> "ascent";
  "basin_invariant" -> "first_exit";
  "basin" -> "basin_invariant";
  "basin" -> "hasDerivWithinAt_integral";
  "basin" -> "tendsto_of_weighted_ascent";
  "basin" -> "trajectory_deriv";
  "basin" -> "trajectory_deriv_ge";
  "isOpen_Ec" -> "isOpen_Oc";
  "basin_Ec" -> "basin";
  "basin_Ec" -> "isOpen_Ec";
  "basin_Ec" -> "mem_Ec";
  "not_asympStable_of_crit_accum" -> "isSolution_const";
  "Example21.stable" -> "stable";
  "ascent" -> "EigBound.psd";
  "ascent" -> "monotoneOn_of_deriv_nonneg'";
  "ascent" -> "trajectory_deriv";
  "ascent_weighted" -> "monotoneOn_of_deriv_nonneg'";
  "ascent_weighted" -> "trajectory_deriv";
  "ascent_weighted" -> "trajectory_deriv_ge";
  "trap" -> "LocalHyp.continuousOn_f";
  "trap" -> "ascent";
  "trap" -> "exists_pos_lower_bound";
  "trap" -> "first_exit";
  "stable_on" -> "trap";
  "stable" -> "stable_on";
  "tendsto_of_weighted_ascent" -> "exists_pos_lower_bound";
  "tendsto_of_weighted_ascent" -> "monotoneOn_of_deriv_nonneg'";
  "asympStable" -> "LocalHyp.continuousOn_f";
  "asympStable" -> "hasDerivWithinAt_integral";
  "asympStable" -> "stable";
  "asympStable" -> "tendsto_of_weighted_ascent";
  "asympStable" -> "trajectory_deriv";
  "asympStable" -> "trajectory_deriv_ge";
  "asympStable" -> "trap";
}
