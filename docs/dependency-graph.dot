    "Example21.not_asympStable" [label=<<FONT FACE="Courier">Example21.not_asympStable</FONT><BR/><FONT POINT-SIZE="9">Ex 2.1</FONT>>, color="#8a5a12", fillcolor="#f6ead2", penwidth=1.6];
  }
  subgraph cluster_Basin { label="Basin.lean"; labeljust=l; style=rounded; color="#d6d8d2"; fontname="Courier"; fontsize=11; fontcolor="#5d646d";
    "basin_invariant" [label=<<FONT FACE="Courier">basin_invariant</FONT>>];
    "basin" [label=<<FONT FACE="Courier">basin</FONT><BR/><FONT POINT-SIZE="9">Thm 3.1</FONT>>, color="#8a5a12", fillcolor="#f6ead2", penwidth=1.6];
    "isOpen_Oc" [label=<<FONT FACE="Courier">isOpen_Oc</FONT><BR/><FONT POINT-SIZE="9">Thm 3.1 (O_c open)</FONT>>, color="#8a5a12", fillcolor="#f6ead2", penwidth=1.6];
    "isOpen_Ec" [label=<<FONT FACE="Courier">isOpen_Ec</FONT>>];
    "mem_Ec" [label=<<FONT FACE="Courier">mem_Ec</FONT>>];
    "basin_Ec" [label=<<FONT FACE="Courier">basin_Ec</FONT><BR/><FONT POINT-SIZE="9">Thm 3.1</FONT>>, color="#8a5a12", fillcolor="#f6ead2", penwidth=1.6];
  }
  subgraph cluster_Stability { label="Stability.lean"; labeljust=l; style=rounded; color="#d6d8d2"; fontname="Courier"; fontsize=11; fontcolor="#5d646d";
