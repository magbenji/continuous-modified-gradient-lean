    "trap" [label=<<FONT FACE="Courier">trap</FONT>>];
    "stable_on" [label=<<FONT FACE="Courier">stable_on</FONT><BR/><FONT POINT-SIZE="9">Thm 2.1(i)</FONT>>, color="#8a5a12", fillcolor="#f6ead2", penwidth=1.6];
    "stable" [label=<<FONT FACE="Courier">stable</FONT><BR/><FONT POINT-SIZE="9">Thm 2.1(i)</FONT>>, color="#8a5a12", fillcolor="#f6ead2", penwidth=1.6];
    "tendsto_of_weighted_ascent" [label=<<FONT FACE="Courier">tendsto_of_weighted_ascent</FONT>>];
    "hasDerivWithinAt_integral" [label=<<FONT FACE="Courier">hasDerivWithinAt_integral</FONT>>];
    "asympStable" [label=<<FONT FACE="Courier">asympStable</FONT><BR/><FONT POINT-SIZE="9">Thm 2.1(ii)</FONT>>, color="#8a5a12", fillcolor="#f6ead2", penwidth=1.6];
  }
  subgraph cluster_Lyapunov { label="Lyapunov.lean"; labeljust=l; style=rounded; color="#d6d8d2"; fontname="Courier"; fontsize=11; fontcolor="#5d646d";
    "trajectory_deriv" [label=<<FONT FACE="Courier">trajectory_deriv</FONT><BR/><FONT POINT-SIZE="9">(TD)</FONT>>, color="#8a5a12", fillcolor="#f6ead2", penwidth=1.6];
    "trajectory_deriv_ge" [label=<<FONT FACE="Courier">trajectory_deriv_ge</FONT>>];
    "ascent" [label=<<FONT FACE="Courier">ascent</FONT><BR/><FONT POINT-SIZE="9">V Lyapunov</FONT>>, color="#8a5a12", fillcolor="#f6ead2", penwidth=1.6];
    "ascent_weighted" [label=<<FONT FACE="Courier">ascent_weighted</FONT>>];
  }
  subgraph cluster_Basic { label="Basic.lean"; labeljust=l; style=rounded; color="#d6d8d2"; fontname="Courier"; fontsize=11; fontcolor="#5d646d";
